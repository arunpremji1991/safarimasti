# SMTP credentials for the contact form and journey-request enquiry emails.
# Both /api/contact and /api/journey-request send to safarimasti@gmail.com via nodemailer.
#
# Easiest option: a Gmail App Password on the safarimasti@gmail.com account
# (Google Account -> Security -> 2-Step Verification -> App Passwords).
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=safarimasti@gmail.com
#   SMTP_PASS=<16-character app password>
#
# Or use a transactional provider (Resend, SendGrid, etc.) and its SMTP relay.

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
